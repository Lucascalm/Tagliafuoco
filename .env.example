# Tagliafuoco: entrambe le chiavi sono OPZIONALI.
# Senza chiavi il progetto gira lo stesso: legge i rilevamenti dalle fixture
# locali e traduce gli ordini con il traduttore deterministico a regole.

# Chiave gratuita di NASA FIRMS. Si richiede qui:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Chiave della API Anthropic, per la traduzione con modello linguistico.
ANTHROPIC_API_KEY=
TAGLIAFUOCO_LLM_MODEL=claude-sonnet-5
